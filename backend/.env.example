# --- Public URLs ------------------------------------------------------------
# The base URL where this app server is reachable. In dev, point this at your
# ngrok / tailscale tunnel so the Pod Provider (armoise.co) can fetch the
# manifest. In prod this is e.g. https://kind.app
APP_BASE_URL=https://your-tunnel.ngrok.app

# The URL of the React frontend. Used by the AppService for OIDC redirects.
APP_FRONT_URL=http://localhost:5173

# --- Local stack ------------------------------------------------------------
# Apache Jena Fuseki (triplestore)
SPARQL_ENDPOINT=http://localhost:3030
SPARQL_USER=admin
SPARQL_PASSWORD=admin

# Redis (Moleculer queues + rate-limit counters)
REDIS_URL=redis://localhost:6379

# --- Moleculer --------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- Kind-specific ---------------------------------------------------------
# Rate limit per user per day (the famous 17)
KIND_DAILY_ACTION_LIMIT=17

# Peer review threshold (number of approvals required to publish a letter)
KIND_REVIEW_THRESHOLD=2

# Time-window closure in the author's timezone — disable by setting to "off"
KIND_QUIET_HOURS_START=22
KIND_QUIET_HOURS_END=7
