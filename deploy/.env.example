# Kind — production environment variables for the backend.
#
# Copy this file to /opt/kind/.env on the VPS and fill in the values. The file
# is NEVER committed to git. docker-compose reads it via `env_file:` so
# changes only require `docker compose up -d` to take effect.

# --- Public URLs -----------------------------------------------------------
APP_BASE_URL=https://api.akindnetwork.org
APP_FRONT_URL=https://akindnetwork.org

# --- Kind business rules (decisions 2026-06-06) ---------------------------
KIND_DAILY_ACTION_LIMIT=17
KIND_REVIEW_THRESHOLD=2
KIND_QUIET_HOURS_START=22
KIND_QUIET_HOURS_END=7

# --- Moleculer ------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- SPARQL / Redis URLs ---------------------------------------------------
# These are overridden by docker-compose.yml so they point at the internal
# service names (oxigraph, redis). Listed here for documentation.
# SPARQL_ENDPOINT=http://oxigraph:7878
# REDIS_URL=redis://redis:6379
