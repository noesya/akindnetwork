# Kind backend — production environment variables.
#
# Copy this file to /opt/kind/.env on the VPS and fill in the values. The file
# is NEVER committed to git. docker-compose reads it via `env_file:` so
# changes only require `docker compose up -d` to take effect.

# --- Public URLs -----------------------------------------------------------
APP_BASE_URL=https://api.akindnetwork.org
APP_FRONT_URL=https://akindnetwork.org

# --- Kind business rules (decisions 2026-06-06) ---------------------------
KIND_DAILY_ACTION_LIMIT=17
KIND_REVIEW_THRESHOLD=2
KIND_QUIET_HOURS_START=22
KIND_QUIET_HOURS_END=7

# --- Moleculer ------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- SemApps datasets ------------------------------------------------------
# Fuseki dataset names used by the core service and auth-account service.
# Auto-created on first connect if absent.
MAIN_DATASET=kind
AUTH_ACCOUNTS_DATASET_NAME=settings

# --- Fuseki credentials ----------------------------------------------------
# Fuseki is only reachable on the Docker internal network (no host port
# exposed), but we still rotate this away from the default 'admin' for
# defense-in-depth. Generate with:  openssl rand -hex 32
FUSEKI_ADMIN_PASSWORD=change-me-openssl-rand-hex-32
SPARQL_USER=admin
SPARQL_PASSWORD=${FUSEKI_ADMIN_PASSWORD}

# --- Redis caches & queues ------------------------------------------------
# Two separate Redis DBs (same instance, different /N suffixes), à la
# activitypods/app-boilerplate. The cache feeds SemApps' CacherMiddleware
# which sits in front of WebAclMiddleware — both required for the LDP create
# flow to commit before listeners fire. Overridden by docker-compose.yml so
# the actual values come from the internal `redis` service name.
# REDIS_CACHE_URL=redis://redis:6379/7
# REDIS_URL=redis://redis:6379/8

# --- SPARQL / Redis URLs ---------------------------------------------------
# These are overridden by docker-compose.yml so they point at the internal
# service names (fuseki, redis). Listed here for documentation only.
# SPARQL_ENDPOINT=http://fuseki:3030
# REDIS_URL=redis://redis:6379
