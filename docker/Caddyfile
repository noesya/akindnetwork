# Kind — Caddy configuration.
#
# Caddy handles TLS termination automatically via Let's Encrypt as long as the
# domain names resolve to this server. The frontend is served as static files;
# the backend is reached via a subdomain.

# ---------------------------------------------------------------------------
# Frontend — static SPA with history fallback.
# ---------------------------------------------------------------------------
akindnetwork.org {
    root * /srv/dist
    encode zstd gzip

    # SPA fallback: any path that doesn't map to a real file returns index.html.
    try_files {path} /index.html
    file_server

    # Long-lived caching for hashed assets, no-cache for the HTML entry point.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @html path / /index.html
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Basic security headers.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
    }
}

# Redirect www → bare (akindnetwork.org is canonical).
www.akindnetwork.org {
    redir https://akindnetwork.org{uri} permanent
}

# ---------------------------------------------------------------------------
# Backend API — proxied to the Moleculer service.
#
# CORS strategy: two cases, both required for the SAI consent flow.
#
#   Case A — request comes from a browser (Origin header present):
#       Reflect the Origin back + Allow-Credentials: true. Lets our own
#       frontend AND any other Pod Provider's consent UI talk to us with
#       Bearer tokens.
#
#   Case B — request has no Origin (server-to-server, or relayed through a
#   Pod's /proxy endpoint that strips Origin before forwarding upstream):
#       Allow-Origin: *, no credentials. This is the path Armoise's consent
#       UI takes: the SPA at app.armoise.co POSTs to armoise.co/<user>/proxy
#       to fetch our /app manifest, the proxy makes a server-side GET to us
#       with no Origin, and then relays our response (CORS headers and all)
#       back to the browser. With `*` the browser at app.armoise.co accepts
#       the proxied response and can render the consent screen.
#
# No leak risk: this backend stores no user data (it lives in user Pods),
# and writes are gated by Bearer + WebACL downstream — CORS doesn't gate
# auth.
# ---------------------------------------------------------------------------
api.akindnetwork.org {
    encode zstd gzip

    # Moleculer-Web emits its own CORS headers, with `*` for the origin. Combined
    # with ours (reflected), the browser sees two `Access-Control-Allow-Origin`
    # headers and rejects the response. We strip every upstream CORS header
    # before the reverse_proxy returns, then add our own controlled set below.
    reverse_proxy moleculer:3000 {
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
        header_down -Access-Control-Allow-Headers
        header_down -Access-Control-Allow-Credentials
        header_down -Access-Control-Expose-Headers
        header_down -Access-Control-Max-Age
        header_down -Vary
    }

    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header {
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
            # LDP/Solid headers commonly sent by SemApps clients in addition
            # to the basics. Without these listed, the preflight fails.
            Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Slug, Link, Prefer, If-Match, If-None-Match"
            Access-Control-Max-Age "86400"
            Vary "Origin"
        }
        # Preflights match the same Case A / Case B split as the actual response.
        @preflight_has_origin header Origin *
        header @preflight_has_origin {
            Access-Control-Allow-Origin "{http.request.header.origin}"
            Access-Control-Allow-Credentials "true"
        }
        @preflight_no_origin {
            not header Origin *
        }
        header @preflight_no_origin Access-Control-Allow-Origin "*"
        respond "" 204
    }

    # Case A: browser request → reflect Origin + credentials.
    @cors_has_origin header Origin *
    header @cors_has_origin {
        Access-Control-Allow-Origin "{http.request.header.origin}"
        Access-Control-Allow-Credentials "true"
        Vary "Origin"
    }
    # Case B: no Origin (server-side / via Pod /proxy) → wildcard, no creds.
    @cors_no_origin {
        not header Origin *
    }
    header @cors_no_origin Access-Control-Allow-Origin "*"

    header {
        # Expose headers SemApps clients READ from cross-origin responses
        # (the `Link` header carries ACL pointers, `Location` carries new
        # resource URIs after POST).
        Access-Control-Expose-Headers "Location, Link, Allow, ETag"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
