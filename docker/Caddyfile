# Kind — Caddy configuration.
#
# Caddy handles TLS termination automatically via Let's Encrypt as long as the
# domain names resolve to this server. The frontend is served as static files;
# the backend is reached via a subdomain.

# ---------------------------------------------------------------------------
# Frontend — static SPA with history fallback.
# ---------------------------------------------------------------------------
akindnetwork.org {
    root * /srv/dist
    encode zstd gzip

    # SPA fallback: any path that doesn't map to a real file returns index.html.
    try_files {path} /index.html
    file_server

    # Long-lived caching for hashed assets, no-cache for the HTML entry point.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @html path / /index.html
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Basic security headers.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
    }
}

# Redirect www → bare (akindnetwork.org is canonical).
www.akindnetwork.org {
    redir https://akindnetwork.org{uri} permanent
}

# ---------------------------------------------------------------------------
# Backend API — proxied to the Moleculer service.
#
# CORS strategy: reflect the request's `Origin` header back as the value of
# `Access-Control-Allow-Origin`. This is intentional, not lazy:
#
#   - Our /app descriptor and the access-need-group it points at are SAI
#     application manifests — they're MEANT to be fetched by any Pod Provider
#     that hosts a user trying to grant our app consent. Restricting Allow-
#     Origin to akindnetwork.org meant Armoise's consent UI (at app.armoise.co)
#     couldn't render: it fetches our manifest via the user's /proxy endpoint,
#     and the browser blocked the response because Origin didn't match.
#
#   - We can't use `*` because we send `Allow-Credentials: true` (the SemApps
#     auth-provider includes the Bearer token via fetch credentials), and the
#     spec forbids combining the two.
#
#   - There is no leak risk in reflecting Origin: this backend stores no user
#     data (it lives in user Pods), and all writes require a Bearer token tied
#     to the user's WebID — CORS doesn't gate that, the access-grant check
#     downstream does.
# ---------------------------------------------------------------------------
api.akindnetwork.org {
    encode zstd gzip

    # Moleculer-Web emits its own CORS headers, with `*` for the origin. Combined
    # with ours (reflected), the browser sees two `Access-Control-Allow-Origin`
    # headers and rejects the response. We strip every upstream CORS header
    # before the reverse_proxy returns, then add our own controlled set below.
    reverse_proxy moleculer:3000 {
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
        header_down -Access-Control-Allow-Headers
        header_down -Access-Control-Allow-Credentials
        header_down -Access-Control-Expose-Headers
        header_down -Access-Control-Max-Age
        header_down -Vary
    }

    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header {
            Access-Control-Allow-Origin "{http.request.header.origin}"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
            # LDP/Solid headers commonly sent by SemApps clients in addition
            # to the basics. Without these listed, the preflight fails.
            Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Slug, Link, Prefer, If-Match, If-None-Match"
            Access-Control-Allow-Credentials "true"
            Access-Control-Max-Age "86400"
            Vary "Origin"
        }
        respond "" 204
    }

    header {
        Access-Control-Allow-Origin "{http.request.header.origin}"
        Access-Control-Allow-Credentials "true"
        # Expose headers SemApps clients READ from cross-origin responses
        # (the `Link` header carries ACL pointers, `Location` carries new
        # resource URIs after POST).
        Access-Control-Expose-Headers "Location, Link, Allow, ETag"
        Vary "Origin"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
