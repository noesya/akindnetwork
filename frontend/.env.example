# Default Pod Provider proposed at /login. Users can override it with their own
# WebID. armoise.co is the test provider maintained by the ActivityPods team.
VITE_DEFAULT_POD_PROVIDER=https://armoise.co

# Optional: URL of the Kind backend (Moleculer node hosting PeerReview etc.).
# Leave unset in pure-frontend mode — the frontend then talks directly to the
# user's Pod Provider without server-side enforcement of peer review / 17-day.
# Set this when you've started backend/ with an ngrok tunnel, e.g.:
# VITE_KIND_BACKEND_URL=https://abcd1234.ngrok.app
VITE_KIND_BACKEND_URL=

# Public URL of this frontend, used to derive the Solid-OIDC client identifier
# (served at /client-id.jsonld). Leave unset to keep the app in anonymous /
# mock-data mode. Set it to your ngrok / production URL when wiring real auth:
# VITE_FRONTEND_URL=https://kind.app
VITE_FRONTEND_URL=

# Override the client ID URL outright (advanced). Most users should set
# VITE_FRONTEND_URL instead and let the app append /client-id.jsonld.
VITE_OIDC_CLIENT_ID=
