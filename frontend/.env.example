# Default Pod Provider proposed at /login. Users can override it with their own
# WebID. armoise.co is the test provider maintained by the ActivityPods team.
VITE_DEFAULT_POD_PROVIDER=https://armoise.co

# URL of the Kind backend — REQUIRED in live mode. The frontend derives the
# Solid-OIDC clientId from this (= ${VITE_KIND_BACKEND_URL}/app, which is the
# SAI Application Profile served by @activitypods/app's AppService). Pod
# Providers fetch this URL when the user logs in to build the consent screen.
VITE_KIND_BACKEND_URL=https://api.akindnetwork.org

# Public URL of this frontend. Setting it switches the app from demo (mock
# data) to live mode. Leave unset locally to keep the prototype showing
# Alice + the mocked letters.
VITE_FRONTEND_URL=

# Override the client ID URL outright (advanced). Most users should set
# VITE_KIND_BACKEND_URL above and let the app append /app to derive it.
VITE_OIDC_CLIENT_ID=
